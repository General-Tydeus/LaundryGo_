@model IEnumerable<LaundryGo.Models.Shop>

@{
    ViewData["Title"] = "Index";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Shops</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
    <h1>Shops nearby</h1>
    @if (User.Identity.IsAuthenticated){
        <a class="btn btn-primary mt-2 mt-md-0" asp-action="Create"> + Create</a>
     }
</div>


<div class="d-flex flex-column" style="height: 80vh;">
    <!-- 50% of the viewport height -->
    <div id="map" class="flex-grow-1" style="height: 100%;"></div>
</div>



<div class="modal fade" id="shopModal" tabindex="-1" aria-labelledby="shopModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shopModalLabel">Shop Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>

            </div>
            <div class="modal-body" id="shopModalBody">
                <!-- Content will be dynamically injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<script>
    var userMarker;
    var userCircle;

    var map = L.map('map').setView([10.669190970892677, 122.97700317993419], 13);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);


    //show all approved shop
@foreach (var shop in Model)
{
    if (shop.Approve == 1)
    {
        <text>
            // Add marker with a popup
            L.marker([@shop.Coord_lat, @shop.Coord_long])
                .addTo(map)
                .bindPopup(`
                    <div style="width: 200px; padding: 10px; text-align: center;">
                        <h5>@shop.Title</h5>
                        <p style="margin: 0; font-size: 14px;">@shop.OfficeHours</p>
                        <p id="distance-@shop.Id" style="margin: 0; font-size: 14px;">Distance: Calculating...</p>
                        <button class="btn btn-primary btn-sm mt-2" onclick="showModal('@shop.Id','@shop.Title', '@shop.Coord_lat', '@shop.Coord_long', '@shop.Address', '@shop.Description', '@shop.OfficeHours')">
                            View Details
                        </button>
                    </div>
                `).on('click', function(e) {
                    calculateDistance([@shop.Coord_lat, @shop.Coord_long], '@shop.Id');
                });
        </text>
    }
}

    function showModal(id, title, lat, long, address, description, OfficeHours) {
        // Update the modal title
        document.getElementById('shopModalLabel').textContent = title;

        // Make an AJAX request to fetch additional data based on the shop ID
        fetch(`/Products/GetProductDetails?productId=${id}`)
            .then(response => response.json())
            .then(data => {
                let modalBodyContent;

                if (data && data.length > 0) {
                    // Build the table with multiple product entries
                    let tableRows = data.map(item => `
                    <tr>
                        <td>${item.productName}</td>
                        <td>${item.price}</td>
                        <td>${item.availability}</td>
                    </tr>
                `).join('');

                    // Table content for modal body
                    modalBodyContent = `
                    <p><strong>Office Hours:</strong> ${OfficeHours}</p>
                    <p><strong>Description:</strong> ${description}</p>
                    <p><strong>Address:</strong> ${address}</p>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Services</th>
                                <th scope="col">Price</th>
                                <th scope="col">Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tableRows}
                        </tbody>
                    </table>
                `;
                } else {
                    // No data available content
                    modalBodyContent = `
                    <p><strong>Office Hours:</strong> ${OfficeHours}</p>
                    <p><strong>Description:</strong> ${description}</p>
                    <p><strong>Address:</strong> ${address}</p>
                    <p>No services available for this shop.</p>
                `;
                }

                // Update the modal body with the content
                document.getElementById('shopModalBody').innerHTML = modalBodyContent;

                // Show the modal
                var myModal = new bootstrap.Modal(document.getElementById('shopModal'));
                myModal.show();
            })
            .catch(error => {
                console.error('Error fetching data:', error);

                // Handle errors by showing a message in the modal
                document.getElementById('shopModalBody').innerHTML = `
                <p>An error occurred while fetching data. Please try again later.</p>
            `;

                // Show the modal
                var myModal = new bootstrap.Modal(document.getElementById('shopModal'));
                myModal.show();
            });
    }

    //get distance
    function calculateDistance(markerLatLng, shopId) {
        if (!userMarker) {
            alert("Unable to calculate distance. Please allow location access.");
            return;
        }

        // Get user's current location
        var userLatLng = userMarker.getLatLng();

        // Calculate the distance using Leaflet's distanceTo function
        var distance = userLatLng.distanceTo(markerLatLng); // Distance in meters

        // Format the distance dynamically
        var distanceText;
        if (distance < 1000) {
            distanceText = `${Math.round(distance)} meters`;
        } else {
            distanceText = `${(distance / 1000).toFixed(2)} km`;
        }

        // Update the popup content
        document.getElementById(`distance-${shopId}`).innerText = `Distance: ${distanceText}`;
    }




    //display current user location and blue zone
    function onLocationFound(e) {
        var radius = e.accuracy / 2;

        if (!userMarker) {
            userMarker = L.marker(e.latlng).addTo(map)
                .bindPopup("You are here!").openPopup();
            userCircle = L.circle(e.latlng, {
                radius: 300,
                color: 'blue',
                fillColor: '#add8e6',
                fillOpacity: 0.5
            }).addTo(map);
        } else {
            userMarker.setLatLng(e.latlng).openPopup();
            userCircle.setLatLng(e.latlng).setRadius(300);
        }
    }

    function onLocationError(e) {
        alert(e.message);
    }

    map.on('locationfound', onLocationFound);
    map.on('locationerror', onLocationError);

    map.locate({ setView: true, maxZoom: 16, watch: true });

</script>

