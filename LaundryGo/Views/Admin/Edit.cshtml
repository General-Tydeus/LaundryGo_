@model LaundryGo.Models.Shop

@{
    ViewData["Title"] = "Edit";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Shops">Shop List</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit Shop</li>
    </ol>
</nav>

<h1>Edit Shop</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                @*<input asp-for="Shop.Address" class="form-control" />*@
                <textarea asp-for="Address" class="form-control" name="Address" rows="3" readonly></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Coord_lat" class="control-label"></label>
                <input asp-for="Coord_lat" class="form-control" id="Shop.Coord_lat" readonly />
                <span asp-validation-for="Coord_lat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Coord_long" class="control-label"></label>
                <input asp-for="Coord_long" class="form-control" id="Shop.Coord_long" readonly />
                <span asp-validation-for="Coord_long" class="text-danger"></span>
            </div>
            @*<div class="form-group">
        <label asp-for="Shop.UserId" class="control-label"></label>*@
            <input type="hidden" asp-for="UserId" class="form-control" readonly />
            <span asp-validation-for="UserId" class="text-danger"></span>
            @*</div>*@
            @*<div class="form-group">
            <label asp-for="Shop.Approve" class="control-label"></label>
            <input type="hidden" asp-for="Shop.Approve" class="form-control" />
            <span asp-validation-for="Shop.Approve" class="text-danger"></span>
        </div>*@
            <div class="form-group">
                <label asp-for="Approve" class="control-label"></label>
                <select asp-for="Approve" class="form-control">
                    <option value="0">Pending</option>
                    <option value="1">Approved</option>
                    <option value="2">Declined</option>
                </select>
                <span asp-validation-for="Approve" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <!-- Map Column -->
    <div class="col-md-8">
        <div id="map" class="d-flex flex-column" style="height: 100%;">
            <div class="flex-grow-1">

            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Shops">Back to List</a>
</div>

<script>
    var currentShopLat = @Model.Coord_lat;
    var currentShopLong = @Model.Coord_long;

    var map = L.map('map').setView([currentShopLat, currentShopLong], 16);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 20,
        attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    // Marker for the current shop
    var currentMarker = L.marker([currentShopLat, currentShopLong])
        .addTo(map)
        .bindPopup("Editing: @Model.Title")
        .openPopup();

    map.locate({ setView: true, maxZoom: 16, watch: true });

    map.on("click", async function (e) {
        console.log("Coordinates: " + e.latlng.toString());
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        // Update input fields
        document.getElementById("Shop.Coord_lat").value = lat;
        document.getElementById("Shop.Coord_long").value = lng;

        // Remove the previous marker if it exists
        if (currentMarker) {
            map.removeLayer(currentMarker);
        }

        // Add the new marker and update the reference
        currentMarker = L.marker(e.latlng).addTo(map);
        const address = await getAddressFromCoords(lat, lng);

        // Update the address input field
        document.querySelector('textarea[name="Address"]').value = address;

        async function getAddressFromCoords(lat, lng) {
            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
                const data = await response.json();
                return data.display_name || "Address not found";
            } catch (error) {
                console.error("Error fetching address:", error);
                return "Unable to fetch address";
            }
        }
    });

</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
