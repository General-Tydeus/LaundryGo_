@model IEnumerable<LaundryGo.Models.Shop>
@{
    var rowIndex = 0;
}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Shop List</li>
        </ol>
    </nav>

<div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
    <h1>List of All Shops</h1>
    @*<a class="btn btn-primary mt-2 mt-md-0" asp-action="Create"> + Create New</a>*@
</div>

<ul class="nav nav-pills">
    <li class="nav-item">
        <a class="nav-link active" href="#" data-filter="all">All</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-filter="1">Approved</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-filter="0">Pending</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-filter="2">Declined</a>
    </li>
</ul>
<br />
<table class="table" id="shopTable">
    <thead>
        <tr class="table-primary">
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            @*<th>@Html.DisplayNameFor(model => model.Coord_lat)</th>
                <th>@Html.DisplayNameFor(model => model.Coord_long)</th>
                <th>@Html.DisplayNameFor(model => model.UserId)</th>*@
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var rowClass = (rowIndex % 2 == 0) ? "table-light" : "table-primary";
            rowIndex++;
            <tr class="@($"status-{item.Approve} {rowClass}")">
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                @*<td>@Html.DisplayFor(modelItem => item.Coord_lat)</td>
                <td>@Html.DisplayFor(modelItem => item.Coord_long)</td>
                <td>@Html.DisplayFor(modelItem => item.UserId)</td>*@
                <td>
                    @if (item.Approve == 0)
                    {
                        @:Pending
                    }
                    else if (item.Approve == 1)
                    {
                        @:Approved
                    }
                    else if (item.Approve == 2)
                    {
                        @:Declined
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">📝</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">🔍</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">🗑</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const filterTabs = document.querySelectorAll(".nav-pills .nav-link"); // Only filter tabs
        const rows = document.querySelectorAll("#shopTable tbody tr");

        filterTabs.forEach(tab => {
            tab.addEventListener("click", function (e) {
                e.preventDefault();

                // Remove "active" class from all filter tabs and add it to the clicked tab
                filterTabs.forEach(t => t.classList.remove("active"));
                this.classList.add("active");

                // Get the filter value
                const filter = this.getAttribute("data-filter");

                // Show/hide rows based on the filter
                rows.forEach(row => {
                    if (filter === "all") {
                        row.style.display = ""; // Show all rows
                    } else if (row.classList.contains("status-" + filter)) {
                        row.style.display = ""; // Show matching rows
                    } else {
                        row.style.display = "none"; // Hide non-matching rows
                    }
                });
            });
        });
    });

</script>
